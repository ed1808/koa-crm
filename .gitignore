# 1. Variables de entorno y credenciales sensibles
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production.local
.env.*.local
*.pem
*.key
*.cert
*.crt
.env.example
.env.production.example

# 2. Dependencias y paquetes
node_modules/
*/node_modules/
.bun/
bun.lockb

# 3. Artefactos de compilación y empaquetado
dist/
*/dist/
build/
*/build/
out/
.tsbuildinfo

# 4. Logs y volcados de depuración
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 5. Archivos del sistema operativo
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db

# 6. Configuraciones de editores e IDEs
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 7. Datos de prueba y coberturas
coverage/
.nyc_output/

# 8. Archivos temporales de Docker / Base de datos local
.docker/
data/
postgres_data/
